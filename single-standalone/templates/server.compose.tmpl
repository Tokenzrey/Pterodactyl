# Generated by mcctl for server {{NAME}} from server.env and modpack.env. Do not edit: the next change to the server overwrites it.
# Nothing is published on the host: the game container is reached only through mc-router, over the mcctl_game network.
# No credential is a value in this file: each is a file under secrets/, mounted at /run/secrets and named with the _FILE suffix.
services:
  mc:
    image: itzg/minecraft-server
    container_name: "{{CONTAINER}}"
    restart: {{RESTART}}
    stop_grace_period: 60s
    mem_limit: "{{MEM_LIMIT}}"
    cpus: {{CPUS}}
    environment:
      EULA: "{{EULA}}"
      TYPE: "{{TYPE}}"
{{VERSION_ENV}}
      MEMORY: "{{MEMORY}}"
      RCON_PASSWORD_FILE: "/run/secrets/rcon_password"
{{EXTRA_ENV}}
{{LIST_ENV}}
    labels:
      - "mcctl.managed=true"
      - "mcctl.name={{NAME}}"
      - "mcctl.hostname={{HOST}}"
      - "mc-router.host={{HOST}}.{{DOMAIN}}"
      - "mcctl.config_hash={{CONFIG_HASH}}"
    secrets:
      - rcon_password
{{MC_SECRET}}
    volumes:
      - ./data:/data
      - ./mods:/mods:ro
      - ./plugins:/plugins:ro
    networks:
      - mcctl_game
  backup:
    image: itzg/mc-backup
    container_name: "{{CONTAINER}}-backup"
    restart: {{RESTART}}
    labels:
      - "mcctl.backup-for={{NAME}}"
    environment:
      RCON_HOST: "127.0.0.1"
      RCON_PASSWORD_FILE: "/run/secrets/rcon_password"
      SRC_DIR: "/data"
      DEST_DIR: "/backups"
      BACKUP_NAME: "{{NAME}}"
{{BACKUP_ENV}}
    secrets:
      - rcon_password
    volumes:
      - ./data:/data:ro
      - ./backups:/backups
    network_mode: "service:mc"
    depends_on: [mc]
networks:
  mcctl_game:
    external: true
secrets:
  rcon_password:
    file: "../../secrets/rcon-{{NAME}}"
{{TOP_SECRET}}
