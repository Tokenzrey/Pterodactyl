# mcctl configuration. ./mcctl init says how to copy this to config/mcctl.env; config/mcctl.env is NOT tracked by Git.
# Syntax: MCCTL_KEY=value, one per line. Only MCCTL_* keys are read, and the file is parsed, never executed.
# Allowed characters in a value: letters, digits and . _ : / @ , + = %  -
# A value already set in the environment wins over this file; an empty value counts as "not set".
# MCCTL_ROOT (the folder that holds config/, secrets/ and servers/) comes from the environment only; it defaults to the
# folder that holds ./mcctl.
#
# No secrets here. The Cloudflare API token is a file, secrets/cloudflare_token (mode 600), never a value in this file.

# ---- DNS (required by create, delete and every command that talks to Cloudflare) -------------------------------------------
# Servers become <name>.<MCCTL_DOMAIN>. The zone that holds this name must be on Cloudflare. Lower-case, no scheme, no path.
MCCTL_DOMAIN=
# The public IPv4 address of this machine: the A records point here. The records are DNS-only (not proxied), so this
# address is visible to anyone who looks the name up.
MCCTL_PUBLIC_IPV4=
# The Zone ID from the Cloudflare dashboard (zone overview, right-hand column).
MCCTL_CF_ZONE_ID=

# ---- Docker network ---------------------------------------------------------------------------------------------------------
# Network the game containers live on: a private IPv4 network written as base/prefix (prefix /16 to /29). It must not
# overlap any Docker network or route that already exists on this machine.
MCCTL_GAME_SUBNET=172.30.0.0/24
# Fixed address of mc-router inside that network: a host address, not the network address, the gateway (the first
# host address, .1 here) or the broadcast address.
MCCTL_ROUTER_IP=172.30.0.2

# ---- Firewall (mcctl firewall) ------------------------------------------------------------------------------------------------
# Per-source connection limit on the router port 25565, enforced in the guard's MCCTL-INGRESS chain
# (DOCKER-USER). Many players behind one shared address (a school, a household) count as one source,
# so raise this when they are cut off. Integer 1 to 65535.
MCCTL_CONN_LIMIT=10
# New-connection rate limit per source on 25565. Format: N/second, N/minute or N/hour (N from 1 to 999999).
MCCTL_RATE=10/second
# SSH ports to keep open, comma-separated. When empty, mcctl detects them from sshd -T, ss and SSH_CONNECTION.
# Every port must be an integer from 1 to 65535.
MCCTL_SSH_PORTS=
# Dead-man timer: after `firewall apply`, ufw is switched off again after this many seconds unless
# `firewall confirm` runs from a new session. 0 disables the timer. Integer 0 to 3600.
MCCTL_FIREWALL_ROLLBACK_SECONDS=300

# ---- File manager (mcctl files) -----------------------------------------------------------------------------------------------
# The user that runs the helper container of `mcctl files`: the game's user in itzg's image is 1000. Integer 1 to 65535.
MCCTL_UID=1000
# The image of that helper. The first `mcctl files` call pulls it, because the helper has no network. Image reference, e.g. alpine:3.20.
MCCTL_DATA_IMAGE=alpine:3.20
