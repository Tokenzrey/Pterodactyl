#!/usr/bin/env bash
# Strict fake `systemd-run` for tests. Models the dead-man timer call:
#   systemd-run --quiet --unit=NAME --on-active=Ns --description=DESC CMD ARGS...
# Appends to $FAKE_STATE/calls.log and touches $FAKE_STATE/rollback.armed.
# Any other invocation is logged as "UNKNOWN systemd-run ARGV" and exits 97.
S=${FAKE_STATE:?FAKE_STATE not set}
mkdir -p "$S"
line=systemd-run
for a in "$@"; do line+=" ${a//$'\n'/\\n}"; done

# accept --quiet --unit=NAME --on-active=Ns --description=DESC CMD...
ok=1
[[ ${1:-} == --quiet ]] || ok=0
[[ ${2:-} == --unit=* ]] || ok=0
[[ ${3:-} == --on-active=* ]] || ok=0
[[ ${4:-} == --description=* ]] || ok=0
(($# >= 5)) || ok=0

if ((!ok)); then
    printf 'UNKNOWN %s\n' "$line" >>"$S/calls.log"
    echo "fake systemd-run: call not modelled: $*" >&2
    exit 97
fi
printf '%s\n' "$line" >>"$S/calls.log"
touch "$S/rollback.armed"
exit 0
