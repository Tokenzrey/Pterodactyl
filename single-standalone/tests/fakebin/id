#!/usr/bin/env bash
# Strict fake `id` for tests. Answers `id -u` with ${FAKE_UID:-0}; passes every other
# call to /usr/bin/id. Every call is appended to $FAKE_STATE/calls.log as "id ARGV".
S=${FAKE_STATE:?FAKE_STATE not set}
mkdir -p "$S"
line=id
for a in "$@"; do line+=" ${a//$'\n'/\\n}"; done
printf '%s\n' "$line" >>"$S/calls.log"

if [[ $# -eq 1 && $1 == -u ]]; then
    echo "${FAKE_UID:-0}"
    exit 0
fi
exec /usr/bin/id "$@"
