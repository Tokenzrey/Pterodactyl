# Pterodactyl deployment configuration.
# Copy to config/deploy.env (./ptero init does that) and edit. config/deploy.env is NOT tracked by Git.
# No secrets here: passwords and the tunnel token live in secrets/ (created by ./ptero init).
# Syntax: KEY=value. Allowed characters in values: letters, digits and . _ : / @ , + = % -

# ---- Identity (required) ------------------------------------------------------------------
# Public hostnames, no scheme, no path. They must be two different names in a zone you control
# on Cloudflare (see docs/cloudflare.md). Placeholder example.* names are rejected.
PANEL_FQDN=
WINGS_FQDN=
# Contact address recorded as the Panel service author (also used as the default admin hint).
ADMIN_EMAIL=
# IANA timezone name, e.g. UTC or Asia/Jakarta
APP_TIMEZONE=UTC

# ---- Beta acknowledgement (required while config/versions.env pins a 2.0 beta) --------------
# Pterodactyl Panel 2.0 is a beta. Set to yes only after reading docs/architecture.md, "Versions and beta risk".
PTERO_ACCEPT_BETA=no

# ---- Local ports (all bound to 127.0.0.1 only) -------------------------------------------------
# Panel, published on the host loopback; the Cloudflare tunnel connects here.
PANEL_BIND_PORT=8081
# Port Wings listens on (127.0.0.1). Must be 443 unless you accept re-patching after every node save:
# the Panel writes api.port from the node's "Daemon Port", and browsers use 443 through Cloudflare.
WINGS_API_PORT=443
# cloudflared readiness/metrics endpoint (127.0.0.1)
TUNNEL_METRICS_PORT=20241

# ---- Docker network ----------------------------------------------------------------------------
# Subnet of the Panel's egress network. Must not overlap any existing Docker network or route.
# The Panel trusts X-Forwarded-* headers only from this range.
PANEL_EDGE_SUBNET=172.29.250.0/24

# ---- Wings -------------------------------------------------------------------------------------
# Where Wings runs.
#   host      = binary + systemd unit on the host (sudo ./ptero wings install). The documented upstream method; use it on a VPS.
#   container = a Compose service (compose.wings.yml) for a machine without systemd + Docker Engine, i.e. Docker Desktop on
#               WSL2. That container holds the Docker socket and bind-mounts host paths: read docs/security.md first.
WINGS_MODE=host
# How Wings reaches the Panel (remote:). With WINGS_MODE=container, `internal` means http://panel:80 on the Compose network.
#   public   = https://PANEL_FQDN, as documented upstream (needs the tunnel to be up)
#   internal = http://127.0.0.1:PANEL_BIND_PORT, no Cloudflare round trip. Panel->Wings heartbeat was
#              verified this way; browser console WebSockets were not. Browser origins are added to allowed_origins.
WINGS_REMOTE_MODE=public
# Address Wings' SFTP server binds to. SFTP is plain SSH and is NOT carried by Cloudflare. With no game servers it has
# no purpose, so it stays on loopback. Set 0.0.0.0 (and open the firewall for port 2022) only when users need SFTP.
WINGS_SFTP_BIND=127.0.0.1
# yes = also apply conservative resource/IO tuning to the Wings config (pid limit 512, disk check every 300 s,
# backup write limit 50 MiB/s, no restart loop on a clean `stop`, upload limit 100 MB = Cloudflare's cap). Existing keys only.
WINGS_TUNING=yes

# ---- Panel extensions and theme (applied by ./ptero setup and ./ptero ext install) -------------------
# Only packages listed in extensions/extensions.lock (reviewed, sha256-pinned) can be named here. Each one runs with
# FULL Panel access, so keep this list short. Comma-separated.
PANEL_EXTENSIONS=announcements,custom-buttons,unix
# classic, or the id of a theme extension from the list above ("unix" = terminal look with a built-in day/night switch)
PANEL_THEME=unix
# Emergency switch: false and ./ptero up if an extension breaks the Panel
PANEL_EXTENSIONS_ENABLED=true
# How long the staff activity log (audit trail) is kept, in days
ACTIVITY_PRUNE_DAYS=365

# ---- Minecraft servers (optional; docs/games.md) ------------------------------------------------
# One public game entry point (mc-router) on GAMES_PORT. Players connect to <server-name>.GAMES_DOMAIN, no port.
# Servers themselves only listen on 127.0.0.1, in the range below, so they cannot be reached except through the router.
GAMES_ENABLED=no
# A dedicated name, e.g. mc.<your domain>. Needs ONE wildcard DNS record, DNS-only: ./ptero games dns
GAMES_DOMAIN=
GAMES_PORT=25565
GAMES_BACKEND_FIRST=25600
GAMES_BACKEND_LAST=25699
GAMES_NODE_ID=1
# New connections per second the router accepts (protects against connection floods)
GAMES_CONN_RATE=10
# Must equal Wings' docker.network.interfaces.v4.subnet (Wings default shown). Used by the egress guard.
GAME_NET_SUBNET=172.18.0.0/16

# ---- Host firewall (ufw): ./ptero firewall plan | apply ---------------------------------------------
# SSH is detected automatically (sshd -T, listening sshd, your current session). Override only if detection is wrong.
FIREWALL_SSH_PORTS=
# Optional: only these addresses may reach SSH (comma-separated IPs/networks). Your current address must be included.
FIREWALL_SSH_ALLOW_CIDRS=
# yes = ufw "limit" (rate-limits new SSH connections; can annoy automation)
FIREWALL_SSH_LIMIT=no
# Optional: only these addresses may reach the game router port (a private/whitelisted community server)
FIREWALL_GAME_ALLOW_CIDRS=
# Seconds before an unconfirmed firewall switches itself off again (0 = never; 60-3600)
FIREWALL_ROLLBACK_SECONDS=300

# ---- Resource limits (containers) ------------------------------------------------------------
DB_MEM_LIMIT=1g
PANEL_MEM_LIMIT=1g
DB_BUFFER_POOL=256M

# ---- Preflight thresholds ---------------------------------------------------------------------
# Minimum free disk (GB) on the filesystem that holds Docker data and backups
MIN_FREE_DISK_GB=10

# ---- Backups -----------------------------------------------------------------------------------
# Optional: encrypt backups with age (https://age-encryption.org). Public recipient only, e.g. age1xxxxxxxx
# Leave empty for plain backups (directory mode 700, files 600). Backups contain APP_KEY and secrets.
BACKUP_AGE_RECIPIENT=
