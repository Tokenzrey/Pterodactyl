# Pinned versions. Tracked in Git. Change deliberately, then run: ./ptero update
# Every image is pinned by digest; the tag in the comment is what the digest was resolved from.
# Resolved 2026-10-19 against the registries (see docs/verification.md).

# Panel 2.0 is still a BETA upstream (latest stable is 1.15.1; upstream says keep production on 1.x).
# This repo targets the 2.0 line. deploy.env must contain PTERO_ACCEPT_BETA=yes while this is a beta.
PANEL_VERSION=v2.0.0-beta.2
PANEL_IMAGE=ghcr.io/pterodactyl/panel@sha256:b3f1229ab8143615a93d8207096059e9903b5b7868cfb34ae0152d22203618c0

# mariadb:11.4
MARIADB_IMAGE=docker.io/library/mariadb@sha256:250e1609e93c0e6aecf64bfbab2d84d5e89d2481540fe77447ff6c855c3b1873
# redis:7.4-alpine
REDIS_IMAGE=docker.io/library/redis@sha256:858f009f9709ce576febc734aa78b8f6d624b82571f9ddb6bda4377c833b3499
# cloudflare/cloudflared:2026.10.1
CLOUDFLARED_IMAGE=docker.io/cloudflare/cloudflared@sha256:a15a3b50b8dabd57ac2090e9484c0247dba9dfa1f0df4d298d4317f9d69eb2d5
# alpine:3.20 (throw-away helper for volume tar/untar and file checks)
UTILITY_IMAGE=docker.io/library/alpine@sha256:d9e853e87e55526f6b2917df91a2115c36dd7c696a35be12163d44e6e2a4b6bc

# Game side (profile `games`, GAMES_ENABLED=yes in deploy.env)
# itzg/mc-router:1.47.2  hostname-based Minecraft router; the single public game entry point (released 2026-10-04)
MCROUTER_IMAGE=docker.io/itzg/mc-router@sha256:64ae69eaa7a6800a79bbf962f027f4020878efa25183359115bc7f6ee569c36e
# python:3.12-slim-bookworm: install container of the modpack egg. Python is already in the image, so the install needs
# no apt; Java for legacy/new Forge, NeoForge and Quilt installers is fetched by the installer when a pack needs it
INSTALLER_IMAGE=docker.io/library/python@sha256:34386ef0cb081344d7ec1c103ba398e6e9f64e9ab3a1509accc92a4e24a07258

# Wings runs on the host as a binary under systemd (officially documented method).
# Upstream documents Wings 1.13.2 to 1.13.4 as tested with Panel 2.0.
WINGS_VERSION=v1.13.4
# sha256 of the release assets (GitHub release asset digests, re-verified by downloading wings_linux_amd64)
WINGS_SHA256_AMD64=7e763389bb5d386a7d32ccdd46cffcf1ab9ed697e5c2aca7fe44183b527cd4c0
WINGS_SHA256_ARM64=516cc0b86fec092feb9893bacab2e1bf478b5477a5459ad9d722676c7549faa5
