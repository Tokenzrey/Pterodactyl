{
    "$schema": "./node_modules/@pterodactyl/sdk/manifest.schema.json",
    "id": "minecraft-suite",
    "name": "Minecraft Suite",
    "version": "1.0.0",
    "requires": {
        "panel": "^2.0.0-dev",
        "sdk": ">=2.0.0-beta.6 <3.0",
        "php": "^8.3"
    },
    "description": "Watch a Minecraft server's TPS, MSPT and uptime from the Panel, with player avatars.",
    "author": "surip",
    "icon": "activity",
    "provider": "MinecraftSuite\\MinecraftSuiteProvider",
    "autoload": {
        "MinecraftSuite\\": "src/"
    },
    "ui": {
        "entry": "dist/client.js",
        "mode": "native",
        "prefix": "mcs",
        "screens": [
            {
                "id": "health",
                "area": "server",
                "path": "health",
                "nav": {
                    "label": "Health",
                    "icon": "activity"
                },
                "permission": ["ext.minecraft-suite.read"]
            }
        ]
    }
}
