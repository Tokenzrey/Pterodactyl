{
    "$schema": "./node_modules/@pterodactyl/sdk/manifest.schema.json",
    "id": "multi-node-sync",
    "name": "Multi-Node Sync",
    "version": "1.0.0",
    "requires": {
        "panel": "^2.0.0-dev",
        "sdk": ">=2.0.0-beta.6 <3.0",
        "php": "^8.3"
    },
    "description": "Migrate server files between nodes and generate S3 presigned URLs for direct transfers.",
    "author": "surip",
    "icon": "network",
    "provider": "MultiNodeSync\\MultiNodeSyncProvider",
    "autoload": {
        "MultiNodeSync\\": "src/"
    },
    "ui": {
        "entry": "dist/client.js",
        "mode": "native",
        "prefix": "mns",
        "screens": [
            {
                "id": "migrations",
                "area": "admin",
                "path": "migrations",
                "nav": {
                    "label": "Migrations",
                    "icon": "arrow-right-left"
                }
            },
            {
                "id": "s3-transfer",
                "area": "admin",
                "path": "s3-transfer",
                "nav": {
                    "label": "S3 Transfer",
                    "icon": "cloud"
                }
            }
        ]
    }
}
