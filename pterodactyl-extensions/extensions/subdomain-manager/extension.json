{
    "$schema": "./node_modules/@pterodactyl/sdk/manifest.schema.json",
    "id": "subdomain-manager",
    "name": "Subdomain Manager",
    "version": "1.0.0",
    "requires": {
        "panel": "^2.0.0-dev",
        "sdk": ">=2.0.0-beta.6 <3.0",
        "php": "^8.3"
    },
    "description": "Create and remove Cloudflare DNS records for game servers.",
    "author": "surip",
    "icon": "globe",
    "provider": "SubdomainManager\\SubdomainManagerProvider",
    "autoload": {
        "SubdomainManager\\": "src/"
    },
    "ui": {
        "entry": "dist/client.js",
        "mode": "native",
        "prefix": "sdm",
        "screens": [
            {
                "id": "subdomains",
                "area": "admin",
                "path": "subdomains",
                "nav": {
                    "label": "Subdomains",
                    "icon": "globe"
                }
            }
        ]
    }
}
